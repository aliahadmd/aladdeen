{
  "name": "aladdeen",
  "version": "0.6.0",
  "private": true,
  "description": "A private, offline-first research workspace for Markdown, HTML, DOCX, PDF, XLSX, and PPTX on macOS arm64.",
  "main": "./out/main/index.js",
  "author": {
    "name": "Ali Ahad",
    "email": "ali@aliahad.com",
    "url": "https://aliahad.com"
  },
  "packageManager": "pnpm@11.5.0",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "check:release": "node scripts/check-release-metadata.mjs",
    "check:spreadsheets": "node scripts/assert-spreadsheet-dependencies.mjs",
    "check:presentations": "node scripts/assert-presentation-dependencies.mjs",
    "icons": "node scripts/generate-icon.mjs",
    "dist": "pnpm dist:mac",
    "dist:mac": "node scripts/assert-macos-arm.mjs && node scripts/assert-docx-editor-dependency.mjs && node scripts/assert-spreadsheet-dependencies.mjs && node scripts/assert-presentation-dependencies.mjs && pnpm icons && pnpm build && electron-builder --mac --arm64 --publish never"
  },
  "dependencies": {
    "@office-kit/xlsx": "0.9.0",
    "@univerjs/core": "0.25.1",
    "@univerjs/preset-sheets-conditional-formatting": "0.25.1",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@univerjs/preset-sheets-data-validation": "0.25.1",
    "@univerjs/preset-sheets-filter": "0.25.1",
    "@univerjs/preset-sheets-find-replace": "0.25.1",
    "@univerjs/preset-sheets-hyper-link": "0.25.1",
    "@univerjs/preset-sheets-sort": "0.25.1",
    "chokidar": "^5.0.0",
    "docx": "^9.5.1",
    "fflate": "^0.8.2",
    "github-slugger": "^2.0.0",
    "image-size": "^2.0.2",
    "katex": "^0.16.27",
    "pdfjs-dist": "^6.1.200",
    "pptx-vanilla-viewer": "1.7.0",
    "pptx-viewer-core": "2.0.7",
    "pptx-viewer-mcp": "2.0.2",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-deflist": "^1.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-smartypants": "^3.0.2",
    "rxjs": "7.8.2",
    "smol-toml": "^1.4.2",
    "three": "0.185.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "write-file-atomic": "^6.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.0.10"
